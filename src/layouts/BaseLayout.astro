---
import '@fontsource/heebo/400.css';
import '@fontsource/heebo/700.css';
import '../styles/global.css';
import {
  House, CalendarDays, Sprout, PackageOpen, Library, Bot, ScrollText, Archive, School, UserRound,
} from '@lucide/astro';
import { site } from '../site.config';
import { url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = `${site.tagline} · ${site.school}, ${site.city}` } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;

const nav = [
  { href: '', label: 'בית', icon: House },
  { href: 'year', label: 'השנה', icon: Sprout },
  { href: 'schedule', label: 'לוח מפגשים', icon: CalendarDays },
  { href: 'toolbox', label: 'ארגז כלים', icon: PackageOpen },
  { href: 'library', label: 'ספריית העשרה', icon: Library },
  { href: 'bots', label: 'בוטים', icon: Bot },
  { href: 'summary', label: 'סיכום שנתי', icon: ScrollText },
  { href: 'archive', label: 'ארכיון', icon: Archive },
];
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\/|\/$/g, '');
const isActive = (href: string) =>
  href === '' ? current === '' : current === href || current.startsWith(href + '/');
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:image" content={new URL(url('media/nature/stream.webp'), Astro.site).href} />
    <meta name="theme-color" content="#faf6ee" />
    <link rel="icon" href={url('favicon.svg?v=clef')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">דלג לתוכן</a>
    <header class="site-header">
      <div class="container brand">
        <a class="site-name" href={url('')}>
          <img src={url('favicon.svg?v=clef')} alt="" width="28" height="28" />
          <span>{site.name}</span>
        </a>
        <p class="site-sub">קהילת מורות במהלך {site.program} · {site.school}, {site.city}</p>
      </div>
      <nav aria-label="ניווט ראשי">
        <ul class="container">
          {nav.map((n) => (
            <li>
              <a href={url(n.href)} aria-current={isActive(n.href) ? 'page' : undefined}>
                <n.icon size={18} aria-hidden="true" />
                <span>{n.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="footer-title">{site.name}</p>
          <p>קהילת מורות לפיתוח מקצועי מבפנים: מורות מבית הספר מובילות שינוי בקרב עמיתות.</p>
        </div>
        <ul class="plain footer-facts">
          <li><School size={18} aria-hidden="true" /> {site.school}, {site.city}</li>
          <li><Sprout size={18} aria-hidden="true" /> במסגרת מהלך "{site.program}"</li>
          <li><UserRound size={18} aria-hidden="true" /> {site.leaderRole}: {site.leader}</li>
        </ul>
      </div>
      <p class="footer-line">{site.footerLine}</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .brand { padding-top: 0.6rem; }
  .site-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text);
    text-decoration: none;
  }
  .site-name img { border-radius: 8px; }
  .site-sub { margin: 0.1rem 0 0; font-size: 0.85rem; color: var(--muted); }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding-block: 0.35rem 0.5rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--text);
    min-height: 38px;
    font-size: 0.95rem;
  }
  @media (min-width: 900px) {
    nav a { padding: 0.4rem 0.8rem; min-height: 44px; font-size: 1rem; }
  }
  /* בטלפון התפריט תופס כמה שורות, ולכן הכותרת לא נדבקת לראש המסך */
  @media (max-width: 699px) {
    .site-header { position: static; }
  }
  nav a:hover { background: var(--accent-soft); }
  nav a[aria-current='page'] { background: var(--accent); color: #fff; }
  main { padding-bottom: 3rem; min-height: 60vh; }
  .site-footer {
    background: var(--text);
    color: #f3efe4;
    padding: 2rem 0 1.25rem;
    margin-top: 2rem;
  }
  .site-footer p { margin: 0.3rem 0; }
  .footer-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 700px) { .footer-grid { grid-template-columns: 3fr 2fr; } }
  .footer-title { font-weight: 700; font-size: 1.1rem; }
  .footer-facts li { display: flex; align-items: center; gap: 0.5rem; margin: 0.45rem 0; }
  .footer-line {
    text-align: center;
    letter-spacing: 0.05em;
    margin-top: 1.25rem !important;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
</style>
