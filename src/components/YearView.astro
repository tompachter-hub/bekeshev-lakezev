---
import { ScrollText } from '@lucide/astro';
import MeetingCard from './MeetingCard.astro';
import PageHero from './PageHero.astro';
import { getMeetings, getSummaries, url, type Year } from '../lib/content';
interface Props { year: Year; }
const { year } = Astro.props;
const meetings = (await getMeetings(year.id)).reverse(); // מהראשון לאחרון
const summary = (await getSummaries()).find((s) => s.data.year === year.id);
---
<PageHero
  title={year.data.title}
  subtitle={`${year.data.hebrewYear}${year.data.current ? ' · השנה' : ''}`}
  image={year.data.current ? 'snail' : 'roots'}
/>
{year.data.description && <p>{year.data.description}</p>}

{summary && (
  <p class="highlight section-head">
    <ScrollText size={20} aria-hidden="true" />
    <a href={url('summary')}>{summary.data.title}</a>
  </p>
)}

<h2>המפגשים</h2>
{meetings.length ? (
  <ol class="plain">
    {meetings.map((m) => <li><MeetingCard meeting={m} /></li>)}
  </ol>
) : (
  <p class="empty">המפגשים של השנה הזו עוד לא הועלו למאגר.</p>
)}
