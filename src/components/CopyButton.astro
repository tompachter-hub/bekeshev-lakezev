---
interface Props {
  text: string;
  label?: string;
}
const { text, label = 'העתקה' } = Astro.props;
---
<div class="copy-wrap">
  <button type="button" class="btn copy-btn" data-copy={text}>{label}</button>
  <span class="copy-status meta" role="status" aria-live="polite"></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      const status = btn.parentElement?.querySelector('.copy-status');
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        ok = document.execCommand('copy');
        ta.remove();
      }
      if (status) {
        status.textContent = ok ? 'הועתק! אפשר להדביק בקבוצה' : 'ההעתקה לא הצליחה, אפשר לסמן את הטקסט ידנית';
        setTimeout(() => (status.textContent = ''), 4000);
      }
    });
  });
</script>

<style>
  .copy-wrap { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
</style>
