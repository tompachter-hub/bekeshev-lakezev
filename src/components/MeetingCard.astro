---
import { url, type Meeting } from '../lib/content';
interface Props { meeting: Meeting; }
const { meeting } = Astro.props;
const d = meeting.data;
const day = d.date.getDate();
const month = d.date.toLocaleDateString('he-IL', { month: 'short' });
const yearNum = d.date.getFullYear();
---
<a class="card-link" href={url(`meetings/${meeting.id}`)}>
  <article class="card with-icon">
    <span class="date-chip" aria-hidden="true">
      <span class="date-day">{day}</span>
      <span class="date-month">{month}</span>
    </span>
    <div>
      <p class="meta">
        מפגש {d.number} · <time datetime={d.date.toISOString().slice(0, 10)}>{day} ב{d.date.toLocaleDateString('he-IL', { month: 'long' })} {yearNum}</time>
        {d.draft && <span class="draft-badge">טיוטה</span>}
      </p>
      <h3>{d.title}</h3>
      <p>{d.summary}</p>
    </div>
  </article>
</a>
