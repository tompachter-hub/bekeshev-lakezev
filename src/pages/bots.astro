---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotCard from '../components/BotCard.astro';
import PageHero from '../components/PageHero.astro';
import { getBots, getYears } from '../lib/content';

const bots = await getBots();
const years = await getYears();
const yearTitle = (id: string) => {
  const y = years.find((y) => y.id === id);
  return y ? `${y.data.hebrewYear} – ${y.data.title}` : id;
};
---
<BaseLayout title="בוטים" description="הבוטים השנתיים של השקפה ואיך משתמשים בהם">
  <PageHero title="בוטים" subtitle="בוט אחד לכל שנה, לתכנון שיעור" image="drop" />
  <p>כל שנה נבנה בוט שעוזר לתכנן שיעור ברוח הנושא השנתי. הבוטים פועלים בג'מיני, ונפתחים בחלון חדש.</p>
  {bots.map((b) => <BotCard bot={b} yearTitle={yearTitle(b.data.year)} />)}
</BaseLayout>
