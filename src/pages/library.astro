---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import { getItems } from '../lib/content';

const articles = (await getItems()).filter((i) => i.data.kind === 'מאמר או מקור');
---
<BaseLayout title="ספריית העשרה" description="מאמרים ומקורות שכדאי להכיר">
  <h1>ספריית העשרה</h1>
  <p>מאמרים ומקורות שעלו במפגשים. ליד כל אחד כתוב למה כדאי לקרוא אותו.</p>
  {articles.length ? (
    articles.map((a) => <ItemCard item={a} />)
  ) : (
    <p class="empty">הספרייה בהקמה, ומאמרים יתווספו בקרוב.</p>
  )}
</BaseLayout>
